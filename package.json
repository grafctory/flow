{
  "name": "@grafctory/flow",
  "version": "0.13.1",
  "description": "Composable primitives for asynchronous data flows.",
  "keywords": [
    "typescript",
    "utilities"
  ],
  "homepage": "https://grafctory.github.io/flow/",
  "bugs": {
    "url": "https://github.com/grafctory/flow/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/flow.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./feeds": {
      "@grafctory/source": "./src/feeds/index.ts",
      "default": "./dist/feeds/index.js"
    },
    "./tasks": {
      "@grafctory/source": "./src/tasks/index.ts",
      "default": "./dist/tasks/index.js"
    },
    "./sinks": {
      "@grafctory/source": "./src/sinks/index.ts",
      "default": "./dist/sinks/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ush ln",
    "build": "ush rm dist docs && npx tsc && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "ush up npx typedoc --watch + ush ws --open docs"
  },
  "dependencies": {
    "@grafctory/core": "^0.14.0"
  },
  "devDependencies": {
    "@grafctory/rack": "^0.8.0",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents": true
  }
}
